{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "height": 15,
        "width": 15,
        "padding": {
            "top": 5,
            "left": 5,
	    "right": 6
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌─Hardware───────────────────────────────────────────┐"
        },
        {
            "type": "host",
            "key": "󰌢  PC"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 "
        },
        {
            "type": "gpu",
            "key": "│ ├󰍹 "
        },
        {
            "type": "memory",
            "key": "│ ├󰑭 "
        },
        {
            "type": "disk",
            "key": "└ └󰋊 "
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "\u001b[90m┌─Software───────────────────────────────────────────┐"
        },
        {
            "type": "os",
            "key": "  OS"
        },
        {
            "type": "kernel",
            "key": "│ ├󰌽 "
        },
        {
            "type": "bios",
            "key": "│ ├󰖡 "
        },
        {
            "type": "packages",
            "key": "│ ├󰏗 "
        },
        {
            "type": "shell",
            "key": "│ ├󰞷 "
        },
        {
            "type": "de",
            "key": "│ ├󰧨 "
        },
        {
            "type": "lm",
            "key": "│ ├󰍁 "
        },
        {
            "type": "wm",
            "key": "│ ├󱂬 "
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉦 "
        },
        {
            "type": "terminal",
            "key": "└ └󰆍 "
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "\u001b[90m┌─Time───────────────────────────────────────────────┐"
        },
        {
            "type": "command",
            "key": "  ›  OS Age  ",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  ›  Uptime  "
        },
        {
            "type": "datetime",
            "key": "  ›  DateTime  "
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "paddingLeft": 2
        }
    ]
}
